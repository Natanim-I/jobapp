<%@page language="java" %>
<html>
    <head>
        <title>Job App - Contact</title>
        <link rel="stylesheet" href="${pageContext.request.contextPath}/css/main.css">
    </head>
    <body>
        <nav>
            <a href="home">Home</a>
            <a href="alljobs">All Jobs</a>
            <a href="contact">Contact Us</a>
        </nav>

        <div class="container">
            <div class="contact-header">
                <h2>Get In Touch</h2>
                <p class="contact-subtitle">We're here to help you with your job search and recruitment needs</p>
            </div>

            <div class="contact-card">
                <h3>Contact Information</h3>
                <p class="email-address">contactjobapp@gmail.com</p>
                <a href="mailto:contactjobapp@gmail.com" class="email-link">Send Email</a>

                <div class="contact-info">
                    <p><strong>Response Time:</strong> We typically respond within 24 hours</p>
                    <p><strong>Business Hours:</strong> Monday - Friday, 9:00 AM - 6:00 PM EST</p>
                    <p><strong>Support:</strong> Available for job seekers and employers</p>
                </div>

                <div class="social-links">
                    <a href="#" class="social-link">FB</a>
                    <a href="#" class="social-link">IG</a>
                    <a href="#" class="social-link">TK</a>
                    <a href="#" class="social-link">X</a>
                </div>
            </div>

            <div class="additional-info">
                <div class="info-card">
                    <h3>Need Help?</h3>
                    <p>Have questions about posting jobs or finding the right candidates? We're here to assist you every step of the way.</p>
                </div>
                <div class="info-card">
                    <h3>Feedback</h3>
                    <p>Your feedback helps us improve our platform. Share your thoughts and suggestions with us.</p>
                </div>
                <div class="info-card">
                    <h3>Partnerships</h3>
                    <p>Interested in partnering with us? Let's discuss how we can work together to create better job opportunities.</p>
                </div>
            </div>
        </div>
    </body>
</html>